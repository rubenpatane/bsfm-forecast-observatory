    "fold_step_days": 90,
    "overlapping_folds": false,
    "minimum_event_bearing_folds": 10,
    "power_rule": "Predictive validation remains blocked unless at least ten non-overlapping folds contain an observed qualifying event, regardless of score direction."
  },
  "uncertainty": {
    "method": "deterministic_gamma_posterior_monte_carlo",
    "samples": 1000,
    "seed": 1301,
    "interval": 0.8
  },
  "publication": {
    "append_only_forecasts": true,
    "content_addressed_inputs": true,
    "blocked_runs_published": true,
