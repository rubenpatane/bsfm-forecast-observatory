  "purpose": "Record public-availability evidence for already-included G1 target outcomes without mutating the historical target census. A later-than-first-known competent-authority publication date is acceptable as a conservative PIT bound; event date alone is never sufficient.",
  "policy": {
    "allowed_bases": ["competent_authority_publication","official_database_publication","archived_public_snapshot"],
    "conservative_rule": "If the earliest public availability cannot be proven, a later dated competent-authority or official intergovernmental public artifact may be used as a conservative available_at bound. This may discard usable history but cannot introduce future information into an earlier cutoff.",
    "prohibited": ["event_date_as_available_at","current_database_presence_without_historical_evidence","approval_or_last_change_timestamp_without publication semantics","retrospective news discoverability without stable public artifact provenance"]
  },
